# Copy this file to .env and fill in real values. .env is gitignored.

# --- Airflow ---
# UID Airflow runs as inside the containers (relevant on Linux hosts to avoid
# volume permission issues; safe to leave as-is on Windows/Mac).
AIRFLOW_UID=50000

# --- Databricks (compute target for dbt-databricks and the Airflow Databricks provider) ---
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=football_analytics

# --- football-data.org (free tier API key, see https://www.football-data.org/client/register) ---
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_COMPETITION=BL1
