# Copy this file to .env and fill in real values. .env is gitignored.

# --- Airflow ---
# UID Airflow runs as inside the containers (relevant on Linux hosts to avoid
# volume permission issues; safe to leave as-is on Windows/Mac).
AIRFLOW_UID=50000

# Encrypts connection passwords stored in the metadata DB. Generate with:
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=

# Signs webserver session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_WEBSERVER_SECRET_KEY=

# Login for the Airflow UI (created once by the airflow-init service).
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=

# --- Databricks (compute target for dbt-databricks and the Airflow Databricks provider) ---
# Hostname only, no https:// prefix (the adapter adds it itself) — from
# SQL Warehouse > Connection Details, e.g. dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=
# From SQL Warehouse > Connection Details, e.g. /sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_HTTP_PATH=
# Personal access token: User Settings > Developer > Access Tokens
DATABRICKS_TOKEN=
# Unity Catalog catalog name (project-scoped, e.g. football_analytics_dev, so it
# doesn't collide with other projects sharing the same Databricks account).
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=football_analytics

# --- football-data.org (free tier API key, see https://www.football-data.org/client/register) ---
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_COMPETITION=BL1
